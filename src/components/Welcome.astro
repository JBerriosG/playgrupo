---
const bentoItems = [
    {
        emoji: "🎮",
        label: "Juegos y atracciones",
        description:
            "Vive la diversión con nuestras atracciones para toda la familia.",
        bg: "bg-[#ff7522]",
        text: "text-white",
        colSpan: "md:col-span-2",
        rowSpan: "",
    },
    {
        emoji: "🎟️",
        label: "Diversión para todos",
        description:
            "Un espacio para jugar, disfrutar y crear grandes recuerdos.",
        bg: "bg-[#668ced]",
        text: "text-white",
        colSpan: "",
        rowSpan: "",
    },
    {
        emoji: "🏆",
        label: "Desafíos y premios",
        description: "Pon a prueba tus habilidades y disfruta cada desafío.",
        bg: "bg-[#668ced]",
        text: "text-white",
        colSpan: "",
        rowSpan: "",
    },
    {
        emoji: "🎂",
        label: "Cumpleaños y celebraciones",
        description: "Celebra tus momentos especiales con mucha entretención.",
        bg: "bg-[#ff7522]",
        text: "text-white",
        colSpan: "md:col-span-2",
        rowSpan: "",
    },
    
];
---

<section class="py-8 px-6 bg-gray-50 pt-20" id="inicio">
    <div class="max-w-5xl mx-auto">
        <!-- Greeting hero -->
        <div class="text-center mb-14">
            <span
                class="inline-flex items-center gap-2 bg-[#ff7522]/10 text-[#ff7522] font-semibold text-sm rounded-full px-4 py-1.5 mb-5"
            >
                🌟 ¡Bienvenidos a Playgrupo!
            </span>
            <h1
                class="text-4xl md:text-5xl font-extrabold text-gray-800 leading-tight mb-5"
            >
                ¡La diversión comienza aquí!<br class="hidden md:block" />
            </h1>
            <p
                class="text-gray-500 text-lg max-w-2xl mx-auto leading-relaxed mb-8"
            >
                En Playgrupo creamos momentos llenos de alegría, juegos y
                entretención para disfrutar en familia. Un espacio donde los más
                pequeños pueden jugar, explorar y vivir experiencias
                inolvidables, mientras grandes y chicos comparten y crean
                recuerdos juntos. <strong class="text-gray-700"
                    >¡Ven a disfrutar y descubre todo lo que Playgrupo tiene
                    para ti!</strong>
                    <div class="flex flex-wrap justify-center gap-4 mb-8">
                        <a
                            href="#planes"
                            class="bg-[#ff7522] text-white font-bold rounded-xl px-8 py-3 hover:bg-[#668ced] transition-colors duration-200"
                        >
                            Ver planes
                        </a>
                        <a
                            href="#contacto"
                            class="border-2 border-[#ff7522] text-[#ff7522] font-bold rounded-xl px-8 py-3 hover:bg-[#ff7522] hover:text-white transition-colors duration-200"
                        >
                            Contactanos
                        </a>
                    </div>
                </p>

            <!-- Bento grid -->
            <div
                class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 auto-rows-[180px] mb-14"
            >
                {
                    bentoItems.map((item) => (
                        <div
                            class={`${item.bg} ${item.text} ${item.colSpan} ${item.rowSpan} rounded-2xl flex flex-col justify-end p-6 shadow-sm hover:-translate-y-1 hover:shadow-lg transition-transform duration-200`}
                        >
                            <span class="text-4xl mb-2">{item.emoji}</span>
                            <p class="font-bold text-lg leading-tight">
                                {item.label}
                            </p>
                            <p class="text-sm opacity-80 mt-1">
                                {item.description}
                            </p>
                        </div>
                    ))
                }
            </div>

            <!-- Trust badges -->
            <!-- <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
                <div class="flex flex-col items-center gap-1">
                    <span class="text-3xl font-extrabold text-[#ff7522]"
                        >+500</span
                    >
                    <p class="text-gray-500 text-sm">Familias</p>
                </div>
                <div class="flex flex-col items-center gap-1">
                    <span class="text-3xl font-extrabold text-[#ff7522]">5</span
                    >
                    <p class="text-gray-500 text-sm">Años de experiencia</p>
                </div>
                <div class="flex flex-col items-center gap-1">
                    <span class="text-3xl font-extrabold text-[#ff7522]"
                        >10+</span
                    >
                    <p class="text-gray-500 text-sm">Actividades semanales</p>
                </div>
                <div class="flex flex-col items-center gap-1">
                    <span class="text-3xl font-extrabold text-[#ff7522]">3</span
                    >
                    <p class="text-gray-500 text-sm">Planes disponibles</p>
                </div>
            </div> -->
        </div>
    </div>
</section>
