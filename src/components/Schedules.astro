---
const days = [
    {
        day: "Lunes",
        slots: [
            { time: "09:00 – 10:00", activity: "Juego libre", age: "1 – 3 años" },
            { time: "10:30 – 11:30", activity: "Música y movimiento", age: "2 – 4 años" },
            { time: "16:00 – 17:00", activity: "Juego libre", age: "1 – 3 años" },
        ],
    },
    {
        day: "Martes",
        slots: [
            { time: "09:00 – 10:00", activity: "Arte y pintura", age: "2 – 5 años" },
            { time: "10:30 – 11:30", activity: "Cuentos y lectura", age: "1 – 3 años" },
            { time: "16:00 – 17:00", activity: "Música y movimiento", age: "2 – 4 años" },
        ],
    },
    {
        day: "Miércoles",
        slots: [
            { time: "09:00 – 10:00", activity: "Juego libre", age: "1 – 3 años" },
            { time: "10:30 – 11:30", activity: "Arte y pintura", age: "2 – 5 años" },
            { time: "16:00 – 17:00", activity: "Cuentos y lectura", age: "1 – 3 años" },
        ],
    },
    {
        day: "Jueves",
        slots: [
            { time: "09:00 – 10:00", activity: "Música y movimiento", age: "2 – 4 años" },
            { time: "10:30 – 11:30", activity: "Juego libre", age: "1 – 3 años" },
            { time: "16:00 – 17:00", activity: "Arte y pintura", age: "2 – 5 años" },
        ],
    },
    {
        day: "Viernes",
        slots: [
            { time: "09:00 – 10:00", activity: "Cuentos y lectura", age: "1 – 3 años" },
            { time: "10:30 – 11:30", activity: "Juego libre", age: "2 – 5 años" },
            { time: "16:00 – 17:00", activity: "Actividad especial", age: "1 – 5 años" },
        ],
    },
];
---

<section class="py-16 px-6 bg-gray-50" id="horarios">
    <div class="max-w-5xl mx-auto">

        <!-- Header -->
        <div class="text-center mb-12">
            <h2 class="text-4xl font-bold text-[#ff7522] mb-3">Horarios</h2>
            <p class="text-gray-500 text-lg">Encontrá el turno ideal para tu familia</p>
        </div>

        <!-- Schedule grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {days.map((dayItem) => (
                <div class="bg-white rounded-2xl border-2 border-gray-200 overflow-hidden shadow-sm hover:-translate-y-1 hover:shadow-lg transition-transform duration-200">

                    <!-- Day header -->
                    <div class="bg-[#ff7522] px-6 py-3">
                        <h3 class="text-white font-bold text-lg">{dayItem.day}</h3>
                    </div>

                    <!-- Time slots -->
                    <ul class="divide-y divide-gray-100">
                        {dayItem.slots.map((slot) => (
                            <li class="flex items-start gap-4 px-6 py-4">
                                <!-- Clock icon -->
                                <svg
                                    class="w-5 h-5 text-[#ff7522] shrink-0 mt-0.5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <circle cx="12" cy="12" r="10" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2" />
                                </svg>
                                <div>
                                    <p class="font-bold text-gray-800 text-sm">{slot.time}</p>
                                    <p class="text-gray-600 text-sm">{slot.activity}</p>
                                    <span class="inline-block mt-1 text-xs font-semibold text-[#668ced] bg-[#668ced]/10 rounded-full px-2 py-0.5">
                                        {slot.age}
                                    </span>
                                </div>
                            </li>
                        ))}
                    </ul>

                </div>
            ))}
        </div>

        <!-- Footer note -->
        <p class="text-center text-gray-400 text-sm mt-10">
            ¿Tenés dudas sobre los horarios?
            <a href="/#contacto" class="text-[#ff7522] font-semibold hover:text-[#668ced] transition-colors">
                Contactanos
            </a>
        </p>

    </div>
</section>
